{
  "name": "deezer-downloader",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @deezer-downloader/shared build && pnpm --parallel --filter @deezer-downloader/server --filter @deezer-downloader/web dev",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0"
  }
}
