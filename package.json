{
  "name": "song-catcher",
  "version": "1.1.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "workspaces": [
    "shared",
    "server",
    "web",
    "desktop"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "build:shared": "npm run build -w @song-catcher/shared",
    "dev:server": "npm run build:shared && npm run dev -w @song-catcher/server",
    "dev:web": "npm run build:shared && npm run dev -w @song-catcher/web",
    "start": "concurrently -n server,web -c blue,magenta \"npm:start:server\" \"npm:start:web\"",
    "start:server": "npm run start -w @song-catcher/server",
    "start:web": "npm run preview -w @song-catcher/web",
    "desktop": "npm run build && npm run start -w @song-catcher/desktop",
    "desktop:dist": "npm run build && npm run fetch-tools -w @song-catcher/desktop && npm run dist -w @song-catcher/desktop",
    "test": "npm run test --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^9.2.1",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0"
  }
}
