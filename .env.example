# deezer-downloader configuration
# Copy this file to .env for local development:
#   cp .env.example .env
# In Docker/systemd, set these as real environment variables instead.

# --- Required ---------------------------------------------------------------
# Your Deezer ARL cookie. See the README for how to retrieve it.
DEEZER_COOKIE_ARL=

# --- Deezer ----------------------------------------------------------------
# mp3 or flac. flac requires a premium account; otherwise the app falls back to mp3.
DEEZER_QUALITY=mp3
# Optional https://, socks5:// or socks5h:// proxy.
DEEZER_PROXY_URL=

# --- HTTP ------------------------------------------------------------------
DEEZER_HTTP_HOST=127.0.0.1
DEEZER_HTTP_PORT=5000
# Optional reverse-proxy prefix, e.g. /deezer
DEEZER_URL_PREFIX=

# --- Downloads -------------------------------------------------------------
DEEZER_WORKERS=4
DEEZER_TASK_HISTORY=500
DEEZER_DOWNLOAD_DIR=/tmp/deezer-downloader
# Optional overrides; defaults are subdirectories of DEEZER_DOWNLOAD_DIR.
# DEEZER_SONGS_DIR=/tmp/deezer-downloader/songs
# DEEZER_ALBUMS_DIR=/tmp/deezer-downloader/albums
# DEEZER_PLAYLISTS_DIR=/tmp/deezer-downloader/playlists
# DEEZER_ZIPS_DIR=/tmp/deezer-downloader/zips
# DEEZER_YOUTUBE_DIR=/tmp/deezer-downloader/youtube-dl

# --- MPD -------------------------------------------------------------------
DEEZER_MPD_ENABLED=false
DEEZER_MPD_HOST=localhost
DEEZER_MPD_PORT=6600
# Required when DEEZER_MPD_ENABLED=true. DEEZER_DOWNLOAD_DIR must be inside it.
# DEEZER_MPD_MUSIC_DIR_ROOT=/tmp/deezer-downloader

# --- External tools --------------------------------------------------------
DEEZER_YTDLP_PATH=yt-dlp
DEEZER_FFMPEG_PATH=ffmpeg
DEEZER_METAFLAC_PATH=metaflac

# --- Logging / debug -------------------------------------------------------
DEEZER_LOG_LEVEL=info
# If set, logs are mirrored here and /api/debug tails this file.
# DEEZER_LOG_FILE=/tmp/deezer-downloader.log
# Optional shell command used by /api/debug; overrides the log-file tail.
# DEEZER_DEBUG_COMMAND=journalctl -u deezer-downloader -n 100 --output cat
