{
  "name": "@song-catcher/server",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "song-catcher": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --env-file-if-exists=../.env --import tsx --watch src/cli.ts",
    "start": "node --env-file-if-exists=../.env dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@song-catcher/shared": "*",
    "@fastify/static": "^10.1.7",
    "archiver": "^7.0.1",
    "cheerio": "^1.2.0",
    "commander": "^15.0.0",
    "egoroof-blowfish": "^4.0.3",
    "fastify": "^5.12.7",
    "got": "^16.1.0",
    "https-proxy-agent": "^9.1.0",
    "node-id3": "^0.2.9",
    "pino": "^10.4.0",
    "socks-proxy-agent": "^10.1.0",
    "tough-cookie": "^6.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.4",
    "@types/node": "^24.19.2",
    "nock": "^15.0.5",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
